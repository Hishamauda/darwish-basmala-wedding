{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Royal Ivory — Champagne Gold — Timeless Romance. Primitive -> semantic -> component.",
  "primitive": {
    "color": {
      "ivory": {
        "50": {
          "$value": "#FAF8F4",
          "$type": "color"
        },
        "0": {
          "$value": "#FFFEFB",
          "$type": "color"
        },
        "10": {
          "$value": "#FFFDF8",
          "$type": "color"
        }
      },
      "pearl": {
        "100": {
          "$value": "#F4EFE8",
          "$type": "color"
        },
        "200": {
          "$value": "#EDE5D8",
          "$type": "color"
        },
        "300": {
          "$value": "#EEE5D7",
          "$type": "color"
        },
        "150": {
          "$value": "#F2EBDF",
          "$type": "color"
        },
        "400": {
          "$value": "#E3D8C6",
          "$type": "color"
        }
      },
      "gold": {
        "300": {
          "$value": "#E9D7AE",
          "$type": "color"
        },
        "400": {
          "$value": "#C6A66B",
          "$type": "color"
        },
        "500": {
          "$value": "#A88348",
          "$type": "color"
        },
        "700": {
          "$value": "#8A6A35",
          "$type": "color"
        },
        "900": {
          "$value": "#6E5328",
          "$type": "color"
        },
        "100": {
          "$value": "#FFF6DE",
          "$type": "color"
        }
      },
      "espresso": {
        "900": {
          "$value": "#30251E",
          "$type": "color"
        },
        "700": {
          "$value": "#5A4A3D",
          "$type": "color"
        }
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color"
      }
    },
    "font": {
      "names": {
        "$value": "'Aref Ruqaa', 'Amiri', serif",
        "$type": "fontFamily"
      },
      "text": {
        "$value": "'Amiri', 'Times New Roman', serif",
        "$type": "fontFamily"
      }
    },
    "spacing": {
      "1": {
        "$value": "0.25rem",
        "$type": "dimension"
      },
      "2": {
        "$value": "0.5rem",
        "$type": "dimension"
      },
      "3": {
        "$value": "0.75rem",
        "$type": "dimension"
      },
      "4": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "6": {
        "$value": "1.5rem",
        "$type": "dimension"
      },
      "8": {
        "$value": "2rem",
        "$type": "dimension"
      },
      "12": {
        "$value": "3rem",
        "$type": "dimension"
      },
      "16": {
        "$value": "4rem",
        "$type": "dimension"
      },
      "24": {
        "$value": "6rem",
        "$type": "dimension"
      }
    },
    "radius": {
      "sm": {
        "$value": "6px",
        "$type": "dimension"
      },
      "md": {
        "$value": "14px",
        "$type": "dimension"
      },
      "lg": {
        "$value": "24px",
        "$type": "dimension"
      },
      "pill": {
        "$value": "999px",
        "$type": "dimension"
      }
    },
    "duration": {
      "fast": {
        "$value": "180ms",
        "$type": "duration"
      },
      "base": {
        "$value": "320ms",
        "$type": "duration"
      },
      "slow": {
        "$value": "700ms",
        "$type": "duration"
      },
      "cinematic": {
        "$value": "1400ms",
        "$type": "duration"
      }
    },
    "easing": {
      "out": {
        "$value": "cubic-bezier(.22,1,.36,1)",
        "$type": "cubicBezier"
      },
      "in-out": {
        "$value": "cubic-bezier(.65,0,.35,1)",
        "$type": "cubicBezier"
      },
      "in": {
        "$value": "cubic-bezier(.55,0,1,.45)",
        "$type": "cubicBezier"
      }
    }
  },
  "semantic": {
    "color": {
      "bg": {
        "$value": "{primitive.color.ivory.50}"
      },
      "surface": {
        "$value": "{primitive.color.pearl.100}"
      },
      "surface-deep": {
        "$value": "{primitive.color.pearl.200}"
      },
      "text": {
        "$value": "{primitive.color.espresso.900}"
      },
      "text-soft": {
        "$value": "{primitive.color.espresso.700}"
      },
      "gold-ornament": {
        "$value": "{primitive.color.gold.400}"
      },
      "gold-display": {
        "$value": "{primitive.color.gold.500}"
      },
      "gold-ink": {
        "$value": "{primitive.color.gold.700}"
      },
      "gold-deep": {
        "$value": "{primitive.color.gold.900}"
      },
      "gold-light": {
        "$value": "{primitive.color.gold.300}"
      },
      "focus": {
        "$value": "{primitive.color.gold.700}"
      },
      "paper-light": {
        "$value": "{primitive.color.ivory.0}"
      },
      "paper-soft": {
        "$value": "{primitive.color.ivory.10}"
      },
      "paper-edge": {
        "$value": "{primitive.color.pearl.300}"
      },
      "gold-glint": {
        "$value": "{primitive.color.gold.100}"
      }
    },
    "space": {
      "inline": {
        "$value": "{primitive.spacing.4}"
      },
      "stack": {
        "$value": "{primitive.spacing.6}"
      },
      "section": {
        "$value": "{primitive.spacing.24}"
      }
    },
    "motion": {
      "micro": {
        "$value": "{primitive.duration.fast}"
      },
      "ui": {
        "$value": "{primitive.duration.base}"
      },
      "reveal": {
        "$value": "{primitive.duration.slow}"
      },
      "scene": {
        "$value": "{primitive.duration.cinematic}"
      },
      "ease": {
        "$value": "{primitive.easing.out}"
      }
    }
  },
  "component": {
    "button": {
      "height": {
        "$value": "52px"
      },
      "radius": {
        "$value": "{primitive.radius.pill}"
      },
      "border": {
        "$value": "{semantic.color.gold-display}"
      },
      "text": {
        "$value": "{semantic.color.gold-deep}"
      }
    },
    "nav": {
      "height": {
        "$value": "64px"
      },
      "radius": {
        "$value": "{primitive.radius.lg}"
      }
    },
    "panel": {
      "radius": {
        "$value": "{primitive.radius.md}"
      },
      "bg": {
        "$value": "{semantic.color.surface}"
      }
    },
    "countdown": {
      "cell-size": {
        "$value": "clamp(68px, 19vw, 104px)"
      },
      "radius": {
        "$value": "{primitive.radius.md}"
      }
    },
    "timeline": {
      "node-size": {
        "$value": "14px"
      },
      "line": {
        "$value": "{semantic.color.gold-ornament}"
      }
    },
    "envelope": {
      "back-start": {
        "$value": "{primitive.color.pearl.150}"
      },
      "back-end": {
        "$value": "{primitive.color.pearl.400}"
      }
    }
  }
}